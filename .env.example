# Copy this file to .env and fill in the values

# MongoDB database (<db_password> is replaced by DATABASE_PASSWORD)
DATABASE=mongodb+srv://user:<db_password>@cluster.mongodb.net/scrumly
DATABASE_PASSWORD=

# JWT
JWT_SECRET_KEY=

# Email (Gmail : use an app password), leave empty to disable the emails
EMAIL_USER=
EMAIL_PASS=

# Server
PORT=7000

# Default admin (created at the first start if it does not exist)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Time zone of the users : it gives the current day (start / end of the sprints, day of the events)
TIMEZONE=Africa/Tunis
